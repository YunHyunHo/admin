# PostgreSQL/Neon 연결 문자열입니다.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# 로컬 PostgreSQL처럼 SSL이 필요 없을 때만 false로 둡니다.
DATABASE_SSL="true"

# 운영 배포 전에 반드시 긴 랜덤 문자열로 변경하세요.
SESSION_SECRET="replace-with-a-long-random-secret"

# 임시 마스터 관리자 계정 비밀번호입니다. 운영에서는 안전한 값으로 바꾸세요.
MASTER_PASSWORD="0000"

# 관리자 앱 주소입니다.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Maple Realtime Server 파일럿을 활성화할 때만 설정합니다.
# Vercel과 Railway에 같은 32자 이상 Secret을 각각 설정해야 합니다.
REALTIME_SERVER_PUBLIC_WS_URL=""
REALTIME_SERVER_INTERNAL_URL=""
REALTIME_SERVER_SHARED_SECRET=""
REALTIME_SERVER_PUSH_SECRET=""

# Railway Realtime Server 전용입니다. LISTEN/NOTIFY를 위해 Neon Direct URL을 사용합니다.
DATABASE_DIRECT_URL=""
REDIS_URL=""
